@model IEnumerable<DevHub.Models.Company>
@{
    ViewData["Title"] = "Công ty đang theo dõi";
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    string keyword = ViewBag.Keyword as string ?? "";
    int totalCount = ViewBag.TotalCount ?? 0;
}

<div class="bg-[#F8F9FA] min-h-screen py-10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col lg:flex-row gap-8">
            
            <!-- Sidebar -->
            <div class="lg:w-[280px] flex-shrink-0">
                @await Html.PartialAsync("~/Views/Candidate/_Sidebar.cshtml")
            </div>

            <!-- Main Content -->
            <div class="flex-1 flex flex-col gap-6">
                <div class="space-y-6">
                    <!-- Header -->
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 bg-white p-6 rounded-2xl shadow-sm border border-slate-200">
                        <div>
                            <h1 class="text-2xl font-bold text-slate-800">Công ty đang theo dõi</h1>
                            <p class="text-sm text-slate-500 mt-1">Bạn đang theo dõi @totalCount công ty</p>
                        </div>
                        <form method="get" action="/Candidate/FollowedCompanies" class="w-full sm:w-auto">
                            <div class="relative">
                                <input type="text" name="keyword" value="@keyword" placeholder="Tìm công ty..." 
                                       class="w-full sm:w-64 pl-10 pr-4 py-2 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all text-sm" />
                                <svg class="w-4 h-4 text-slate-400 absolute left-3.5 top-1/2 -translate-y-1/2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                                </svg>
                            </div>
                        </form>
                    </div>

                    @if (Model != null && Model.Any())
                    {
                        <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
                            @foreach (var company in Model)
                            {
                                <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm hover:shadow-md transition-all group flex flex-col h-full relative overflow-hidden">
                                    
                                    <!-- Decorative background element -->
                                    <div class="absolute top-0 right-0 w-32 h-32 bg-primary/5 rounded-bl-full -z-0 pointer-events-none opacity-0 group-hover:opacity-100 transition-opacity"></div>
                                    
                                    <div class="flex items-start gap-4 mb-5 relative z-10">
                                        <a href="/Company/Detail/@company.CompanyId" class="w-16 h-16 rounded-xl shrink-0 overflow-hidden border border-slate-100 bg-white flex items-center justify-center shadow-sm group-hover:scale-105 transition-transform">
                                            @if (!string.IsNullOrEmpty(company.CompanyLogoUrl))
                                            {
                                                <img src="@company.CompanyLogoUrl" alt="@company.CompanyName" class="w-full h-full object-contain p-2" />
                                            }
                                            else
                                            {
                                                <div class="w-full h-full bg-slate-50 flex items-center justify-center text-xl font-bold text-slate-400">
                                                    @(company.CompanyName.Length > 0 ? company.CompanyName[0].ToString() : "C")
                                                </div>
                                            }
                                        </a>
                                        <div class="flex-1 min-w-0">
                                            <h3 class="font-bold text-lg text-slate-900 leading-tight mb-1 truncate group-hover:text-primary transition-colors">
                                                <a href="/Company/Detail/@company.CompanyId" title="@company.CompanyName">@company.CompanyName</a>
                                            </h3>
                                            <div class="flex items-center gap-2 text-xs text-slate-500">
                                                <span class="flex items-center gap-1">
                                                    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
                                                    @(company.Industry ?? "Lĩnh vực khác")
                                                </span>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="mt-auto space-y-3 relative z-10">
                                        <!-- Rating -->
                                        <div class="flex items-center justify-between text-sm">
                                            <span class="text-slate-500">Đánh giá</span>
                                            @if (company.ReviewCompanies.Any())
                                            {
                                                var avg = company.ReviewCompanies.Average(r => r.Rating);
                                                <div class="flex items-center gap-1 font-semibold text-slate-700">
                                                    <span class="text-amber-400">★</span>
                                                    <span>@avg.ToString("F1")</span>
                                                    <span class="text-slate-400 font-normal">(@company.ReviewCompanies.Count)</span>
                                                </div>
                                            }
                                            else
                                            {
                                                <span class="text-slate-400 italic text-xs">Chưa có đánh giá</span>
                                            }
                                        </div>
                                        
                                        <div class="h-px bg-slate-100 w-full my-3"></div>

                                        <!-- Actions -->
                                        <div class="flex items-center gap-3 mt-4">
                                            <a href="/Company/Detail/@company.CompanyId" class="flex-1 text-center py-2 px-4 bg-primary text-white rounded-xl text-sm font-bold hover:bg-[#4338CA] transition-colors shadow-sm">
                                                Xem hồ sơ
                                            </a>
                                            <button type="button" onclick="unfollow(@company.CompanyId, this)" class="shrink-0 p-2 text-slate-400 hover:text-red-500 hover:bg-red-50 rounded-xl transition-colors border border-slate-200 hover:border-red-200" title="Bỏ theo dõi">
                                                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                                                    <path d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
                                                </svg>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>

                        <!-- Pagination -->
                        @if (totalPages > 1)
                        {
                            <div class="flex justify-center mt-8">
                                <nav class="inline-flex rounded-xl shadow-sm border border-slate-200 overflow-hidden">
                                    @for (int i = 1; i <= totalPages; i++)
                                    {
                                        <a href="/Candidate/FollowedCompanies?page=@i&keyword=@keyword" 
                                           class="px-4 py-2 border-r last:border-r-0 border-slate-200 text-sm font-medium transition-colors @(i == currentPage ? "bg-primary text-white" : "bg-white text-slate-600 hover:bg-slate-50")">
                                            @i
                                        </a>
                                    }
                                </nav>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="bg-white rounded-2xl border border-slate-200 p-12 text-center shadow-sm">
                            <div class="w-24 h-24 mx-auto bg-slate-50 rounded-full flex items-center justify-center mb-6">
                                <svg class="w-12 h-12 text-slate-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                                </svg>
                            </div>
                            <h3 class="text-lg font-bold text-slate-800 mb-2">Chưa có công ty nào</h3>
                            <p class="text-slate-500 mb-6">Bạn chưa theo dõi công ty nào. Hãy tìm kiếm và theo dõi các công ty bạn quan tâm để nhận thông báo việc làm mới nhất.</p>
                            <a href="/companies" class="inline-flex items-center gap-2 px-6 py-2.5 bg-primary text-white rounded-xl font-bold hover:bg-[#4338CA] transition-colors shadow-sm">
                                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                                </svg>
                                Khám phá công ty
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/toastify-js"></script>
    <link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/toastify-js/src/toastify.min.css">
    
    <script>
        function unfollow(companyId, btnElement) {
            if(!confirm("Bạn có chắc muốn bỏ theo dõi công ty này?")) return;
            
            fetch('/Candidate/ToggleFollowCompany', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                },
                body: `companyId=${companyId}`
            })
            .then(res => res.json())
            .then(data => {
                if(data && data.success && !data.isFollowed) {
                    Toastify({
                        text: "Đã bỏ theo dõi công ty",
                        duration: 3000,
                        gravity: "bottom",
                        position: "right",
                        style: { background: "#64748b" }
                    }).showToast();
                    
                    // Remove card from DOM
                    btnElement.closest('.bg-white').remove();
                }
            });
        }
    </script>
}

