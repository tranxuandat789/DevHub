@model List<DevHub.Models.Province>
@{
    ViewData["Title"] = "Quản lý Tỉnh/Thành phố";
    Layout = "~/Views/Shared/_ModeratorLayout.cshtml";
    var keyword = ViewData["Keyword"] as string ?? "";
    var status = ViewData["Status"] as string ?? "";
    var region = ViewData["Region"] as string ?? "";
}

<div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-8 gap-4">
    <div>
        <h1 class="text-[32px] font-bold text-dark mb-2">Quản lý Tỉnh/Thành phố</h1>
        <p class="text-muted">Định nghĩa các tỉnh/thành phố để sử dụng cho mục địa điểm làm việc của ứng viên và bài đăng tuyển dụng.</p>
    </div>
    <a href="/ModeratorProvince/Create" class="bg-primary text-white font-bold px-6 py-3 rounded-lg hover:bg-opacity-90 transition-all flex items-center gap-2 shadow-sm">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
        Thêm Tỉnh/Thành phố
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="bg-green-50 border-l-4 border-green-500 p-4 mb-6 rounded-r-lg">
        <div class="flex items-center">
            <svg class="w-5 h-5 text-green-500 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
            <p class="text-green-700 font-medium">@TempData["SuccessMessage"]</p>
        </div>
    </div>
}

<!-- Filters & Sort -->
<div class="bg-white rounded-[20px] shadow-[0_8px_30px_rgb(0,0,0,0.12)] p-6 mb-8 border border-[#D6DDEB]">
    <form method="get" action="/ModeratorProvince" class="grid grid-cols-1 md:grid-cols-5 gap-4 items-end">
        <div class="w-full md:col-span-2">
            <label class="block text-dark font-medium mb-2 text-sm">Tìm kiếm tên</label>
            <input type="text" name="keyword" value="@keyword" placeholder="Nhập tên tỉnh/thành phố..." class="w-full border border-[#D6DDEB] rounded-lg px-4 py-2.5 focus:outline-none focus:border-primary text-muted">
        </div>
        <div class="w-full">
            <label class="block text-dark font-medium mb-2 text-sm">Khu vực (Miền)</label>
            <select name="region" class="w-full border border-[#D6DDEB] rounded-lg px-4 py-2.5 focus:outline-none focus:border-primary text-muted">
                <option value="" selected="@(region == "" ? "selected" : null)">Tất cả</option>
                <option value="North" selected="@(region == "North" ? "selected" : null)">Miền Bắc</option>
                <option value="Central" selected="@(region == "Central" ? "selected" : null)">Miền Trung</option>
                <option value="South" selected="@(region == "South" ? "selected" : null)">Miền Nam</option>
            </select>
        </div>
        
        <div class="w-full">
            <label class="block text-dark font-medium mb-2 text-sm">Sắp xếp thứ tự</label>
            <select name="sortOrder" class="w-full border border-[#D6DDEB] rounded-lg px-4 py-2.5 focus:outline-none focus:border-primary text-muted">
                <option value="asc" selected="@(ViewData["SortOrder"] as string == "asc" ? "selected" : null)">Từ trên xuống (Mặc định)</option>
                <option value="desc" selected="@(ViewData["SortOrder"] as string == "desc" ? "selected" : null)">Ngược từ dưới lên</option>
            </select>
        </div>

        <div>
            <button type="submit" class="w-full bg-primary text-white font-bold px-6 py-2.5 rounded-lg hover:bg-opacity-90 transition-all">Lọc dữ liệu</button>
        </div>
    </form>
</div>

<!-- Data Table -->
<div class="bg-white rounded-[20px] shadow-[0_8px_30px_rgb(0,0,0,0.12)] border border-[#D6DDEB] overflow-hidden">
    <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse min-w-[700px]">
            <thead>
                <tr class="bg-gray-50 border-b border-[#D6DDEB]">
                    <th class="py-4 px-6 text-dark font-bold text-sm">Tên Tỉnh/Thành phố</th>
                    <th class="py-4 px-6 text-dark font-bold text-sm w-40 text-center">Trạng thái</th>
                    <th class="py-4 px-6 text-dark font-bold text-sm w-32 text-center">Thứ tự</th>
                    <th class="py-4 px-6 text-dark font-bold text-sm w-32 text-center">Thao tác</th>
                </tr>
            </thead>
            <tbody class="text-sm">
                @if (Model != null && Model.Any())
                {
                    foreach (var p in Model)
                    {
                        var isActive = p.IsActive;
                        <tr class="border-b border-[#D6DDEB] hover:bg-gray-50 transition-colors">
                            <td class="py-4 px-6">
                                <div class="font-bold text-dark text-base">@p.ProvinceName</div>
                            </td>
                            <td class="py-4 px-6 text-center">
                                @if (isActive)
                                {
                                    <span id="status-badge-@p.ProvinceId" class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-green-100 text-green-800">
                                        Hoạt động
                                    </span>
                                }
                                else
                                {
                                    <span id="status-badge-@p.ProvinceId" class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-red-100 text-red-800">
                                        Tạm ngưng
                                    </span>
                                }
                            </td>
                            <td class="py-4 px-6 text-center">
                                <span class="font-bold text-dark" id="display-order-@p.ProvinceId">@p.DisplayOrder</span>
                            </td>
                            <td class="py-4 px-6 text-center">
                                <div class="flex items-center justify-center space-x-2">
                                    <button type="button" onclick="editOrder(@p.ProvinceId, @p.DisplayOrder)" class="inline-flex items-center justify-center w-8 h-8 rounded-full bg-blue-50 text-blue-600 hover:bg-blue-100 transition-colors" title="Chỉnh sửa thứ tự">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"></path></svg>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4" class="py-8 text-center text-muted">Không tìm thấy tỉnh/thành phố nào.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    @if (ViewBag.TotalPages > 1)
    {
        <div class="px-6 py-4 border-t border-[#D6DDEB] flex flex-col md:flex-row items-center justify-between bg-gray-50 gap-4">
            <span class="text-sm text-muted">
                Hiển thị trang <span class="font-bold text-dark">@ViewBag.CurrentPage</span> / @ViewBag.TotalPages 
                (Tổng số <span class="font-bold text-dark">@ViewBag.TotalItems</span> mục)
            </span>
            <div class="flex gap-2">
                @if (ViewBag.CurrentPage > 1)
                {
                    <a href="?keyword=@ViewData["Keyword"]&status=@ViewData["Status"]&region=@ViewData["Region"]&sortOrder=@ViewData["SortOrder"]&page=@(ViewBag.CurrentPage - 1)" class="px-3 py-1 bg-white border border-[#D6DDEB] rounded hover:bg-gray-100 text-sm font-medium text-dark transition-colors">Trang trước</a>
                }
                
                @{
                    int currentPage = ViewBag.CurrentPage;
                    int totalPages = ViewBag.TotalPages;
                    int maxPages = 4;
                    int startPage = Math.Max(1, currentPage - (maxPages / 2));
                    int endPage = startPage + maxPages - 1;
                    
                    if (endPage > totalPages)
                    {
                        endPage = totalPages;
                        startPage = Math.Max(1, endPage - maxPages + 1);
                    }
                }
                
                @for (int i = startPage; i <= endPage; i++)
                {
                    <a href="?keyword=@ViewData["Keyword"]&status=@ViewData["Status"]&region=@ViewData["Region"]&sortOrder=@ViewData["SortOrder"]&page=@i" class="px-3 py-1 border rounded text-sm font-medium transition-colors @(i == ViewBag.CurrentPage ? "bg-primary text-white border-primary" : "bg-white border-[#D6DDEB] text-dark hover:bg-gray-100")">@i</a>
                }

                @if (ViewBag.CurrentPage < ViewBag.TotalPages)
                {
                    <a href="?keyword=@ViewData["Keyword"]&status=@ViewData["Status"]&region=@ViewData["Region"]&sortOrder=@ViewData["SortOrder"]&page=@(ViewBag.CurrentPage + 1)" class="px-3 py-1 bg-white border border-[#D6DDEB] rounded hover:bg-gray-100 text-sm font-medium text-dark transition-colors">Trang sau</a>
                }
            </div>
        </div>
    }
</div>

<!-- Toast Notification -->
<div id="toast-container" class="fixed bottom-5 right-5 z-50 flex flex-col gap-2"></div>
<!-- Edit Order Modal -->
<div id="editOrderModal" class="fixed inset-0 z-[100] hidden items-center justify-center p-4 sm:p-0">
    <div class="fixed inset-0 bg-gray-900 bg-opacity-50 transition-opacity" onclick="closeEditOrderModal()"></div>
    <div class="bg-white rounded-xl shadow-xl transform transition-all sm:max-w-md w-full relative z-10 overflow-hidden">
        <div class="p-6">
            <h3 class="mb-4 text-lg font-bold text-dark text-center">Cập nhật Thứ tự Hiển thị</h3>
            <p class="text-sm text-muted mb-6 text-center">Nhập thứ tự hiển thị ưu tiên (số càng nhỏ càng xuất hiện trên cùng).</p>
            
            <div class="mb-6">
                <input type="number" id="editOrderInput" class="w-full border border-[#D6DDEB] rounded-lg px-4 py-3 focus:outline-none focus:border-primary text-center text-lg font-bold text-dark" placeholder="Nhập số thứ tự..." min="0">
            </div>

            <div class="flex justify-center gap-3">
                <button type="button" onclick="closeEditOrderModal()" class="flex-1 text-muted bg-white hover:bg-gray-100 border border-[#D6DDEB] focus:ring-4 focus:outline-none focus:ring-gray-100 rounded-lg text-sm font-medium px-5 py-2.5 transition-colors">
                    Hủy bỏ
                </button>
                <button type="button" onclick="submitEditOrder()" class="flex-1 text-white bg-primary hover:bg-opacity-90 focus:ring-4 focus:outline-none focus:ring-blue-300 font-medium rounded-lg text-sm px-5 py-2.5 text-center transition-colors">
                    Cập nhật
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function showToast(message, isSuccess = true) {
            const toast = document.createElement('div');
            toast.className = `flex items-center p-4 rounded-lg shadow-lg text-white transform transition-all duration-300 translate-y-10 opacity-0 ${isSuccess ? 'bg-green-500' : 'bg-red-500'}`;
            toast.innerHTML = `
                <svg class="w-6 h-6 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    ${isSuccess 
                        ? '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>'
                        : '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>'
                    }
                </svg>
                <span class="font-medium">${message}</span>
            `;
            
            document.getElementById('toast-container').appendChild(toast);
            
            setTimeout(() => {
                toast.classList.remove('translate-y-10', 'opacity-0');
            }, 10);

            setTimeout(() => {
                toast.classList.add('opacity-0', 'translate-y-10');
                setTimeout(() => toast.remove(), 300);
            }, 3000);
        }

        async function updateProvinceOrder(id, newOrder) {
            if (!newOrder || isNaN(newOrder)) return;
            
            try {
                const response = await fetch(`/ModeratorProvince/update-order/${id}`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded'
                    },
                    body: new URLSearchParams({ displayOrder: newOrder })
                });
                
                if (response.ok) {
                    const result = await response.json();
                    if (result.success) {
                        showToast(result.message);
                        setTimeout(() => window.location.reload(), 800);
                    } else {
                        showToast("Có lỗi xảy ra", false);
                    }
                } else {
                    showToast("Lỗi kết nối server", false);
                }
            } catch (error) {
                showToast("Lỗi kết nối server", false);
            }
        }

        let currentEditOrderId = null;

        function editOrder(id, currentOrder) {
            currentEditOrderId = id;
            const input = document.getElementById('editOrderInput');
            input.value = currentOrder;
            
            document.getElementById('editOrderModal').classList.remove('hidden');
            document.getElementById('editOrderModal').classList.add('flex');
            
            setTimeout(() => {
                input.focus();
                input.select();
            }, 100);
        }

        function closeEditOrderModal() {
            currentEditOrderId = null;
            document.getElementById('editOrderModal').classList.add('hidden');
            document.getElementById('editOrderModal').classList.remove('flex');
        }

        function submitEditOrder() {
            if (!currentEditOrderId) return;
            const newOrder = document.getElementById('editOrderInput').value;
            const parsed = parseInt(newOrder);
            if (!isNaN(parsed) && parsed >= 0) {
                const idToUpdate = currentEditOrderId;
                closeEditOrderModal();
                updateProvinceOrder(idToUpdate, parsed);
            } else {
                showToast("Vui lòng nhập số hợp lệ", false);
            }
        }
    </script>
}
